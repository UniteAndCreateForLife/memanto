{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SYS_EXECUTABLE}\" -m memanto memory sync --project-dir .",
            "timeout": 30,
            "statusMessage": "Loading MEMANTO memory..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SYS_EXECUTABLE}\" -m memanto memory sync --project-dir .",
            "timeout": 30,
            "statusMessage": "Saving MEMANTO memory..."
          }
        ]
      }
    ]
  }
}
